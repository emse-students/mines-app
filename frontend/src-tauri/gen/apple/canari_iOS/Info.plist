<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.16.5</string>
	<key>CFBundleVersion</key>
	<string>1600501</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>processing</string>
		<string>fetch</string>
		<!-- NO `voip` HERE, DELIBERATELY. The mode is only legitimate for an app that reports an
		     incoming call to CallKit, and calling is held off (frontend/src/lib/features.ts,
		     CALLS_ENABLED) until it has been run on hardware. App Review refused the declaration
		     under guideline 2.5.4 on 2026-08-31 for a VoIP service it could not locate - correctly,
		     since on that build no iPad could even register a push token. Re-add it in the SAME
		     commit that flips CALLS_ENABLED and restores CanariCallKitSetup(), never before: an
		     undeclared-but-unused mode is a rejection, and a used-but-undeclared one cannot get a
		     PushKit token at all. -->
	</array>
	<!-- BGTaskScheduler identifiers the app may submit. Must list every identifier passed to
	     registerForTaskWithIdentifier: / submitTaskRequest: or BGTaskScheduler throws. This
	     BGProcessingTask is the iOS analogue of Android's expedited MlsBackgroundWorker: it
	     drains mls_pending.db (canari_native_cleanup_pending_db) when the OS grants a
	     background-processing window. Note: iOS never wakes a force-quit app, so a user who
	     swipes the app away receives no silent data pushes and no BGTask runs until relaunch. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>fr.emse.canari.cleanup</string>
		<string>fr.emse.canari.outboxRetry</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<!-- Android goes edge-to-edge but keeps the status bar, reading its insets via
	     env(safe-area-inset-top); iOS now matches that decision instead of hiding the bar
	     outright (docs/wiki/frontend/android-ios-parity.md#1.1). UIStatusBarStyleDefault
	     auto-switches dark/light content with the system appearance since iOS 13, mirroring
	     Android's system-driven icon colour. UIViewControllerBasedStatusBarAppearance is
	     explicitly false so this plist value is what actually governs - Tauri/wry installs no
	     view controller that overrides preferredStatusBarStyle, so without this the key is a
	     dead declaration (the empty-string bug this replaces, docs/wiki/frontend/android-ios-parity.md#1.2). -->
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<!-- Custom URL scheme registration for tauri-plugin-deep-link custom-scheme links
	     (OIDC callback fr.emse.canari://callback, Stripe return, chat/post/form routing).
	     On Android the plugin generates the intent-filter into AndroidManifest.xml at build
	     time; on iOS the CFBundleURLTypes entry must be declared here manually or the OS
	     never hands the URL back to the app - which would break Authentik OIDC login. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>fr.emse.canari</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fr.emse.canari</string>
			</array>
		</dict>
	</array>
	<!-- Supported localizations for the Info.plist usage strings. iOS resolves the device
	     language against this list and loads the matching <lang>.lproj/InfoPlist.strings
	     (fr/en); an unsupported language falls back to the base values below (French, the
	     app's development region). Keep in sync with the canari_iOS/*.lproj folders. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
		<string>en</string>
	</array>
	<!-- Privacy usage strings: iOS hard-crashes on first access to a protected resource
	     when its *UsageDescription key is absent. Face ID in particular crashes the biometric
	     unlock flow without NSFaceIDUsageDescription. These base values are French (app is
	     French-first) and act as the fallback; per-locale overrides live in
	     canari_iOS/{fr,en}.lproj/InfoPlist.strings (WP-iOS-10). -->
	<key>NSCameraUsageDescription</key>
	<string>Canari utilise l'appareil photo pour prendre des photos et vidéos à partager dans vos conversations.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Canari utilise le microphone pour enregistrer des messages vocaux.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Canari accède à vos photos pour les partager dans vos conversations.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Canari utilise Face ID pour déverrouiller l'application de façon sécurisée.</string>
	<!-- KEPT YES, but nothing here depends on it any more, and that is deliberate. The proxy is
	     the DECLARED APNs<->FCM bridge and it installed nothing: it samples
	     sharedApplication.delegate once, at [FIRApp configure], which main() runs before wry
	     creates the application. CanariInstallApnsTokenHook does the bridging instead. This stays
	     YES so the proxy keeps doing the OTHER jobs it is credited with should it ever attach
	     (it uses class_replaceMethod, which chains rather than replaces), and so that turning it
	     off is a deliberate act rather than a silent change of two mechanisms at once. -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<true/>
	<!-- App Store Connect compliance: the app includes end-to-end encryption (MLS messages,
	     device keys, vaults, etc.) that is not covered by an encryption exemption. Declaring
	     this in Info.plist avoids the annual compliance question in App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
</dict>
</plist>
